NODE_ENV=development
PORT=5000

# MongoDB MUST run as a replica set (Prisma + transactions). `docker compose up -d` gives you one.
# Atlas: mongodb+srv://<user>:<password>@<cluster>/shoplytics
DATABASE_URL="mongodb://127.0.0.1:27017/shoplytics?replicaSet=rs0&directConnection=true"

# Redis: sessions, password-reset tokens, login lockout and rate limiting.
# docker-compose starts Redis with REDIS_PASSWORD. Use hex so it needs no URL-escaping:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@127.0.0.1:6379
# Refuse to start without Redis (default: true in production, false otherwise).
# REDIS_REQUIRED=true

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# (production refuses to start while this is still the placeholder)
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# Access token lifetime (seconds). Short on purpose - sessions live in Redis.
ACCESS_TOKEN_TTL_SECONDS=900
# Session (refresh token) lifetime: normal login / "remember me"
REFRESH_TTL_SECONDS=86400
REFRESH_TTL_REMEMBER_SECONDS=2592000

# Comma-separated list of allowed frontend origins (CORS). The FIRST one is used in password-reset links.
# Required in production.
CLIENT_URL=http://localhost:5173

BCRYPT_SALT_ROUNDS=12

# Number of reverse proxies in front of the API (so req.ip is the real client IP). 0 = none.
# Behind nginx / Traefik / Caddy / a cloud load balancer, set 1: otherwise every user shares the proxy's IP
# and rate limits + login lockouts hit everyone at once. Do NOT set it without a proxy - clients could then
# spoof X-Forwarded-For to dodge rate limits.
TRUST_PROXY=0

# Brute-force protection for /auth/login (per IP + email)
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900

RATE_LIMIT_ENABLED=true

# Outgoing email (password resets) over SMTP: SES, SendGrid, Mailgun, Postmark, Gmail, ...
# SMTP_HOST unset: development prints reset links to the console; production logs a warning and sends nothing.
SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS (port 465), false = STARTTLS (port 587)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Shoplytics <no-reply@example.com>"
