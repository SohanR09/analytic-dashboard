// Shoplytics data model (MongoDB + Prisma). See docs/REQUIREMENTS.md section 10.
//
// Sync with:  npx prisma db push      (MongoDB does not use `prisma migrate`)
// MongoDB must run as a replica set - Prisma relies on transactions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Per-business role. A user can hold a different role in each business.
enum BusinessRole {
  OWNER
  ADMIN
  MANAGER
  ANALYST
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum MovementType {
  INITIAL
  PURCHASE
  SALE
  RETURN
  CANCELLATION
  ADJUSTMENT
}

enum ReportStatus {
  PENDING
  COMPLETED
  FAILED
}

// ---------------------------------------------------------------------------
// Embedded (composite) types - order snapshots keep history intact even when
// a product is later edited or deleted.
// ---------------------------------------------------------------------------

type OrderItem {
  productId    String  @db.ObjectId
  name         String
  sku          String
  categoryId   String? @db.ObjectId
  categoryName String
  quantity     Int
  unitPrice    Float
  unitCost     Float
  totalPrice   Float
}

type ShippingAddress {
  name       String?
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String?
  country    String
}

type OrderEvent {
  status  OrderStatus
  note    String?
  actorId String?     @db.ObjectId
  at      DateTime
}

// ---------------------------------------------------------------------------
// Collections
// ---------------------------------------------------------------------------

model User {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  email             String   @unique
  password          String
  profileImage      String?
  defaultBusinessId String?  @db.ObjectId
  preferences       Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  memberships BusinessMember[]
  reports     Report[]

  @@map("users")
}

model Business {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  category    String
  logo        String?
  website     String?
  currency    String   @default("USD")
  timezone    String   @default("UTC")
  /// Inventory alert + preference settings (validated in the application layer).
  settings    Json?
  /// Last issued order sequence number (atomic $inc), used for ORD-000001 style numbers.
  orderSeq    Int      @default(0)
  ownerId     String   @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members BusinessMember[]

  @@index([ownerId])
  @@map("businesses")
}

/// Membership + role. This is what authorization is based on.
model BusinessMember {
  id         String       @id @default(auto()) @map("_id") @db.ObjectId
  businessId String       @db.ObjectId
  userId     String       @db.ObjectId
  role       BusinessRole
  createdAt  DateTime     @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
  @@map("business_members")
}

model Category {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  businessId  String   @db.ObjectId
  name        String
  description String?
  createdAt   DateTime @default(now())

  products Product[]

  @@unique([businessId, name])
  @@map("categories")
}

model Product {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  businessId        String   @db.ObjectId
  name              String
  description       String?
  sku               String
  categoryId        String?  @db.ObjectId
  price             Float
  costPrice         Float    @default(0)
  stockQuantity     Int      @default(0)
  minimumStockLevel Int      @default(10)
  image             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  category  Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  movements InventoryMovement[]

  @@unique([businessId, sku])
  @@index([businessId, categoryId])
  @@index([businessId, stockQuantity])
  @@map("products")
}

model Customer {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  businessId String   @db.ObjectId
  name       String
  email      String?
  phone      String?
  city       String?
  country    String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orders Order[]

  @@index([businessId, createdAt])
  @@index([businessId, email])
  @@map("customers")
}

model Order {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  businessId      String           @db.ObjectId
  customerId      String?          @db.ObjectId
  orderNumber     String
  items           OrderItem[]
  /// Gross item revenue (sum of item totals, before discounts).
  subtotal        Float
  discountAmount  Float            @default(0)
  taxAmount       Float            @default(0)
  shippingAmount  Float            @default(0)
  /// Refunded merchandise value (excludes tax / shipping).
  refundAmount    Float            @default(0)
  /// What the customer was billed: subtotal - discount + tax + shipping.
  totalAmount     Float
  paymentStatus   PaymentStatus    @default(PENDING)
  paymentMethod   String?
  orderStatus     OrderStatus      @default(PENDING)
  shippingAddress ShippingAddress?
  notes           String?
  timeline        OrderEvent[]
  orderDate       DateTime         @default(now())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([businessId, orderNumber])
  @@index([businessId, orderDate])
  @@index([businessId, orderStatus, orderDate])
  @@index([businessId, customerId, orderDate])
  /// Multikey indexes on the embedded line items: product detail + product/category sales filters.
  @@index([businessId, items.productId])
  @@index([businessId, items.categoryId])
  @@map("orders")
}

model InventoryMovement {
  id               String       @id @default(auto()) @map("_id") @db.ObjectId
  businessId       String       @db.ObjectId
  productId        String       @db.ObjectId
  movementType     MovementType
  /// Signed change (+ in, - out).
  quantity         Int
  previousQuantity Int
  newQuantity      Int
  reason           String?
  /// e.g. the order that caused a SALE / CANCELLATION movement.
  referenceId      String?      @db.ObjectId
  actorId          String?      @db.ObjectId
  createdAt        DateTime     @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([productId, createdAt])
  @@map("inventory_movements")
}

model Report {
  id         String       @id @default(auto()) @map("_id") @db.ObjectId
  businessId String       @db.ObjectId
  userId     String       @db.ObjectId
  reportType String
  title      String
  filters    Json
  /// { columns, rows, summary } - generated at request time, exported on demand.
  data       Json?
  status     ReportStatus @default(PENDING)
  error      String?
  fileUrl    String?
  createdAt  DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@map("reports")
}
